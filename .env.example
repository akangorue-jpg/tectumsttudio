# Copiar a .env y exportar antes de iniciar el servidor.
PORT=3000
HOST=127.0.0.1
TECTUM_DATA_DIR=./data
# Clave maestra de 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TECTUM_SECRET_KEY=
# TECTUM_SECURE_COOKIES=1
# TECTUM_TRUST_PROXY=1
LOG_LEVEL=info
